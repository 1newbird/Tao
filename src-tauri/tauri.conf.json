{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tao",
  "version": "0.2.0",
  "identifier": "com.bangtaoh.tao",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run tao:prepare && npm.cmd run tao:verify && npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tao",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "useLocalToolsDir": true,
    "windows": {
      "wix": {
        "fragmentPaths": ["windows/sandbox-lifecycle.wxs"],
        "componentGroupRefs": ["TaoSandboxLifecycle"]
      }
    },
    "resources": {
      "resources/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
