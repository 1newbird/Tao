  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-dev.ps1",
    "test:agents": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-agents.ps1",
    "test:ui": "node scripts/test-ui-rendering.mjs",
    "test:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-sandbox.ps1",
    "preview": "vite preview",
    "preview:ui": "node scripts/preview-ui.mjs",
    "tao:prepare": "node scripts/prepare-tauri-release.mjs",
    "tao:node": "node scripts/build-sandbox-node.mjs",
    "tao:verify": "node scripts/verify-tauri-release.mjs",
    "tao:release": "node scripts/release-tauri.mjs",
    "tao:release:nsis": "node scripts/release-tauri.mjs --bundles nsis",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-cli.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
